            document.querySelectorAll('.game-item').forEach(m => m.remove());

            gameInterval = setInterval(updateTimer, 1000);
            spawnInterval = setInterval(spawnItem, 550); // Velocidad ajustada
        }

        function updateTimer() {
            timeLeft--;
            timerDisplay.innerText = timeLeft + "s";
            
            if (timeLeft <= 0) {
                endGame();
            }
        }

        function endGame() {
            clearInterval(gameInterval);
            clearInterval(spawnInterval);
            document.querySelectorAll('.game-item').forEach(m => m.remove());
            finalScore.innerText = score;
            overlay.classList.remove('hidden');
        }

        function spawnItem() {
            const item = document.createElement('div');
            item.className = 'game-item';
            
            // 35% de probabilidad de que sea un coco malo/pasado
            const isBad = Math.random() < 0.35;
            // Si es bueno, hay 50% probabilidad que caiga entero o cortado
            const type = isBad ? 'malo' : (Math.random() > 0.5 ? 'entero' : 'cortado');
            
            item.innerHTML = `<svg viewBox="0 0 100 100" class="w-full h-full pointer-events-none"><use href="#svg-coco-${type}"></use></svg>`;

            const maxX = gameArea.clientWidth - 80;
            const maxY = gameArea.clientHeight - 100;
            const randomX = Math.floor(Math.random() * maxX) + 10;
            const randomY = Math.floor(Math.random() * maxY) + 40; 

            item.style.left = randomX + 'px';
            item.style.top = randomY + 'px';

            item.onmousedown = function(e) {
                if(isBad) {
                    score -= 5;
                    showFloatingText("-5", e.clientX, e.clientY, "text-red-500");
                    gameArea.classList.add('bg-red-300');
                    setTimeout(() => gameArea.classList.remove('bg-red-300'), 150);
                } else {
                    score += 10;
                    showFloatingText("+10", e.clientX, e.clientY, "text-coco-dark");
                }
                scoreDisplay.innerText = score;
                
                item.classList.add('splat-effect');
                setTimeout(() => item.remove(), 400);
            };

            gameArea.appendChild(item);

            // Desaparecer automáticamente si no se hace clic
            setTimeout(() => {
                if(item.parentNode && !item.classList.contains('splat-effect')) {
                    item.style.opacity = '0';
                    item.style.transform = 'scale(0) translateY(50px)';
                    setTimeout(() => { if(item.parentNode) item.remove(); }, 300);
                }
            }, 1200 + Math.random() * 1000);
        }

        function showFloatingText(text, x, y, colorClass) {
            const floatText = document.createElement('div');
            floatText.innerText = text;
            floatText.className = `floating-score ${colorClass}`;
            
            const rect = gameArea.getBoundingClientRect();
            floatText.style.left = (x - rect.left - 20) + 'px';
            floatText.style.top = (y - rect.top - 20) + 'px';

            gameArea.appendChild(floatText);
            setTimeout(() => floatText.remove(), 1000);
        }
    </script>
</body>
</html>
