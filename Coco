                const isCut = Math.random() > 0.6;
                const size = Math.random() * 50 + 40; 
                
                item.innerHTML = `<svg viewBox="0 0 100 100" style="width:${size}px; height:${size}px;" class="drop-shadow-lg"><use href="#svg-coco-${isCut ? 'cortada' : 'entero'}"></use></svg>`;
                
                item.style.left = `${Math.random() * 90}vw`;
                item.style.animationDuration = `${Math.random() * 15 + 10}s`;
                item.style.animationDelay = `-${Math.random() * 20}s`;
                
                container.appendChild(item);
            }
        }
