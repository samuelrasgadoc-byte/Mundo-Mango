    <link href="https://fonts.googleapis.com/css2?family=Chewy&family=Nunito:wght@400;600;800;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mango: {
                            light: '#FFD166',
                            DEFAULT: '#FF9F1C',
                            dark: '#E85D04',
                            leaf: '#2D6A4F',
                            leafLight: '#40916C',
                            bg: '#FFFDF7',
                            green: '#A7C957'
                        }
                    },
                    fontFamily: {
                        sans: ['Nunito', 'sans-serif'],
                        display: ['Chewy', 'cursive'],
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'spin-slow': 'spin 12s linear infinite',
                        'wiggle': 'wiggle 1.5s ease-in-out infinite',
                        'pulse-fast': 'pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0) rotate(0deg)' },
                            '50%': { transform: 'translateY(-20px) rotate(5deg)' },
                        },
                        wiggle: {
                            '0%, 100%': { transform: 'rotate(-5deg)' },
                            '50%': { transform: 'rotate(5deg)' },
                        },
                        fall: {
                            '0%': { transform: 'translateY(-10vh) rotate(0deg) scale(0.8)', opacity: '0' },
                            '10%': { opacity: '0.6' },
                            '90%': { opacity: '0.6' },
                            '100%': { transform: 'translateY(110vh) rotate(360deg) scale(1.2)', opacity: '0' }
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Cursor Personalizado */
        body {
            cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="%23E85D04"><path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4Z"/></svg>') 12 12, auto;
        }
        
        a, button, .cursor-pointer {
            cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="%232D6A4F"><path d="M12,2L15,9L22,12L15,15L12,22L9,15L2,12L9,9L12,2Z"/></svg>') 12 12, pointer !important;
        }

        /* Animaciones Reveal */
        .reveal {
            opacity: 0;
            transform: translateY(50px) scale(0.9);
            transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        .delay-100 { transition-delay: 100ms; }
        .delay-200 { transition-delay: 200ms; }
        .delay-300 { transition-delay: 300ms; }

        /* Contenedor de Lluvia de Mangos */
        #falling-mangos-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }
        .falling-mango {
            position: absolute;
            animation: fall linear infinite;
        }

        /* Degradados */
        .text-gradient {
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-image: linear-gradient(to right, #E85D04, #FF9F1C, #FFD166);
        }

        /* Estilos del Minijuego */
        #game-area {
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg, #87CEEB 0%, #E0F6FF 100%);
            border-radius: 2rem;
            box-shadow: inset 0 10px 30px rgba(0,0,0,0.15);
            cursor: crosshair;
        }
        .tree-canopy {
            position: absolute;
            top: -100px;
            left: -50px;
            right: -50px;
            height: 250px;
            background: #2D6A4F;
            border-radius: 50%;
            box-shadow: 
                inset -20px -20px 60px rgba(0,0,0,0.3),
                0 20px 40px rgba(0,0,0,0.2);
            z-index: 1;
        }
        .tree-canopy::after {
            content: '';
            position: absolute;
            bottom: -30px;
            left: 20%;
            width: 60%;
            height: 100px;
            background: #40916C;
            border-radius: 50%;
            z-index: -1;
        }
        .game-mango {
            position: absolute;
            width: 60px;
            height: 60px;
            cursor: pointer;
            z-index: 10;
            user-select: none;
            transition: transform 0.1s;
            filter: drop-shadow(0 5px 5px rgba(0,0,0,0.3));
        }
        .game-mango:active {
            transform: scale(0.7) rotate(15deg);
        }
        .floating-score {
            position: absolute;
            font-family: 'Chewy', cursive;
            font-size: 2.5rem;
            pointer-events: none;
            animation: floatUp 1s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            z-index: 20;
            text-shadow: 2px 2px 0 #fff, -2px -2px 0 #fff, 2px -2px 0 #fff, -2px 2px 0 #fff;
        }
        @keyframes floatUp {
            0% { transform: translateY(0) scale(0.5); opacity: 0; }
            50% { opacity: 1; transform: translateY(-30px) scale(1.2); }
            100% { transform: translateY(-60px) scale(1); opacity: 0; }
        }
        .splat-effect {
            animation: splat 0.4s ease-out forwards;
        }
        @keyframes splat {
            0% { transform: scale(1); opacity: 1; filter: brightness(1); }
            50% { transform: scale(1.5); opacity: 0.8; filter: brightness(1.5); }
            100% { transform: scale(2); opacity: 0; filter: brightness(2); }
        }

        /* Blob Background */
        .blob-shape {
            border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
            animation: blob-morph 8s ease-in-out infinite;
        }
        @keyframes blob-morph {
            0%, 100% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
            34% { border-radius: 70% 30% 50% 50% / 30% 30% 70% 70%; }
            67% { border-radius: 100% 60% 60% 100% / 100% 100% 60% 60%; }
        }
    </style>
</head>
