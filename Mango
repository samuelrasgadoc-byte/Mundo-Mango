    <!-- SCRIPTS -->
    <script>
        // --- FUNCIÓN PARA DESCARGAR EL HTML ---
        function downloadHTML() {
            // Obtenemos todo el contenido de la etiqueta <html>
            const htmlContent = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
            
            // Creamos un Blob con el contenido de texto
            const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            
            // Creamos una etiqueta <a> invisible para forzar la descarga
            const link = document.createElement('a');
            link.href = url;
            link.download = 'Proyecto_Mundo_Mango_Samuel.html'; // Nombre del archivo al descargar
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        // 1. Navbar Scroll Effect
        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('shadow-md', 'py-0');
                navbar.classList.remove('h-24');
                navbar.classList.add('h-16');
            } else {
                navbar.classList.remove('shadow-md', 'py-0', 'h-16');
                navbar.classList.add('h-24');
            }
        });

        // 2. Efecto Reveal on Scroll
        function reveal() {
            var reveals = document.querySelectorAll(".reveal");
            for (var i = 0; i < reveals.length; i++) {
                var windowHeight = window.innerHeight;
                var elementTop = reveals[i].getBoundingClientRect().top;
                if (elementTop < windowHeight - 100) {
                    reveals[i].classList.add("active");
                }
            }
        }
        window.addEventListener("scroll", reveal);
        reveal();

        // 3. Generador de Lluvia de Mangos (Background)
        function createFallingMangos() {
            const container = document.getElementById('falling-mangos-container');
            const numMangos = 15;

            for (let i = 0; i < numMangos; i++) {
                const mango = document.createElement('div');
                mango.className = 'falling-mango';
                
                const isGreen = Math.random() > 0.7;
                const size = Math.random() * 40 + 30; 
                
                mango.innerHTML = `<svg viewBox="0 0 100 100" style="width:${size}px; height:${size}px;" class="drop-shadow-lg"><use href="#svg-mango-${isGreen ? 'verde' : 'maduro'}"></use></svg>`;
                
                mango.style.left = `${Math.random() * 90}vw`;
                mango.style.animationDuration = `${Math.random() * 15 + 10}s`;
                mango.style.animationDelay = `-${Math.random() * 20}s`;
                
                container.appendChild(mango);
            }
        }
        createFallingMangos();

        // 4. Lógica del Minijuego "Fiebre de Cosecha"
        let score = 0;
        let timeLeft = 20;
        let gameInterval;
        let spawnInterval;
        const gameArea = document.getElementById('game-area');
        const startBtn = document.getElementById('startBtn');
        const scoreDisplay = document.getElementById('scoreDisplay');
        const timerDisplay = document.getElementById('timerDisplay');
        const overlay = document.getElementById('game-overlay');
        const finalScore = document.getElementById('finalScore');

        function startGame() {
            score = 0;
            timeLeft = 20;
            scoreDisplay.innerText = score;
            timerDisplay.innerText = timeLeft + "s";
            
            startBtn.classList.add('hidden');
            gameArea.classList.remove('hidden');
            overlay.classList.add('hidden');
            
            document.querySelectorAll('.game-mango').forEach(m => m.remove());

            gameInterval = setInterval(updateTimer, 1000);
            spawnInterval = setInterval(spawnMango, 550); // Ligeramente más rápido para mayor diversión
        }

        function updateTimer() {
            timeLeft--;
            timerDisplay.innerText = timeLeft + "s";
            
            if (timeLeft <= 0) {
                endGame();
            }
        }

        function endGame() {
            clearInterval(gameInterval);
            clearInterval(spawnInterval);
            document.querySelectorAll('.game-mango').forEach(m => m.remove());
            finalScore.innerText = score;
            overlay.classList.remove('hidden');
        }

        function spawnMango() {
            const mango = document.createElement('div');
            mango.className = 'game-mango';
            
            const isGreen = Math.random() < 0.35;
            
            mango.innerHTML = `<svg viewBox="0 0 100 100" class="w-full h-full pointer-events-none"><use href="#svg-mango-${isGreen ? 'verde' : 'maduro'}"></use></svg>`;

            const maxX = gameArea.clientWidth - 80;
            const maxY = gameArea.clientHeight - 100;
            const randomX = Math.floor(Math.random() * maxX) + 10;
            const randomY = Math.floor(Math.random() * maxY) + 40; 

            mango.style.left = randomX + 'px';
            mango.style.top = randomY + 'px';

            mango.onmousedown = function(e) {
                if(isGreen) {
                    score -= 5;
                    showFloatingText("-5", e.clientX, e.clientY, "text-red-500");
                    gameArea.classList.add('bg-red-300');
                    setTimeout(() => gameArea.classList.remove('bg-red-300'), 150);
                } else {
                    score += 10;
                    showFloatingText("+10", e.clientX, e.clientY, "text-mango-dark");
                }
                scoreDisplay.innerText = score;
                
                mango.classList.add('splat-effect');
                setTimeout(() => mango.remove(), 400);
            };

            gameArea.appendChild(mango);

            setTimeout(() => {
                if(mango.parentNode && !mango.classList.contains('splat-effect')) {
                    mango.style.opacity = '0';
                    mango.style.transform = 'scale(0) translateY(50px)';
                    setTimeout(() => { if(mango.parentNode) mango.remove(); }, 300);
                }
            }, 1200 + Math.random() * 1000);
        }

        function showFloatingText(text, x, y, colorClass) {
            const floatText = document.createElement('div');
            floatText.innerText = text;
            floatText.className = `floating-score ${colorClass}`;
            
            const rect = gameArea.getBoundingClientRect();
            floatText.style.left = (x - rect.left - 20) + 'px';
            floatText.style.top = (y - rect.top - 20) + 'px';

            gameArea.appendChild(floatText);
            setTimeout(() => floatText.remove(), 1000);
        }
    </script>
</body>
</html>
